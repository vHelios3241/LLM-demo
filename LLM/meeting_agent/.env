# ---------- 数据库（MySQL） ----------
# 与 docker‑compose.yml 中的 MySQL 服务保持一致
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=meeting_agent

# ---------- OpenAI（用于会议摘要 + 待办提取）----------
# 如使用兼容 OpenAI 接口的第三方服务（如灵积 / OneAPI 等），改 BASE_URL 即可
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- 阿里云语音转写 ASR（用于录音转文字）----------
# 采用阿里云百炼 / DashScope 平台的 Paraformer 系列模型
# API Key 在「百炼控制台」获取；BASE_URL 为 DashScope 服务地址
ALIYUN_ASR_API_KEY=sk-your-aliyun-dashscope-api-key
ALIYUN_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_ASR_MODEL=paraformer-v2

# ---------- 应用运行参数 ----------
APP_DEBUG=true